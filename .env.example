# Application
APP_ENV=development
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
PUBLIC_V2_ENABLED=false

# Database
DATABASE_URL=sqlite:///./data/weekly_agent.db
TEST_DATABASE_URL=sqlite:///./data/test_weekly_agent.db

# Telegram
TELEGRAM_BOT_TOKEN=replace_with_development_bot_token
TELEGRAM_ADMIN_ID=
TELEGRAM_WEBHOOK_SECRET=replace_with_random_webhook_secret
TELEGRAM_WEBHOOK_URL=https://replace.example/webhook
TELEGRAM_MINI_APP_URL=https://replace.example
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
MAX_WEBHOOK_BODY_BYTES=1048576

# Sessions and browser security
SESSION_SIGNING_SECRET=replace_with_at_least_32_random_bytes
SESSION_MAX_AGE_SECONDS=900
SESSION_COOKIE_NAME=pr_agent_session
CSRF_COOKIE_NAME=pr_agent_csrf
CORS_ORIGINS=http://localhost:3000

# AI and transcription
AI_PROVIDER=groq
TRANSCRIPTION_PROVIDER=groq
NUTRITION_PROVIDER=disabled
GROQ_API_KEY=disabled
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=disabled
LLM_TEMPERATURE=0.3
WHISPER_MODEL=whisper-large-v3-turbo
WHISPER_LANGUAGE=auto

# Feature gates
INVITE_ONLY=true
MESSAGE_CLEANUP_ENABLED=false
SUNDAY_DIGEST_ENABLED=false
AI_AGENT_ENABLED=false
NUTRITION_ENABLED=false
REMINDER_WORKER_ENABLED=false

# Limits
MAX_VOICE_FILE_SIZE=20971520
MAX_VOICE_DURATION_SECONDS=300
MAX_TEXT_LENGTH=4096
PER_USER_DAILY_AI_LIMIT=25
PER_USER_DAILY_NUTRITION_LIMIT=10

# Worker and monitoring
REDIS_URL=
SENTRY_DSN=

# Legacy compatibility (removed in later public-v2 phases)
WEBHOOK_URL=http://localhost:8000
CHROMA_PERSIST_DIR=./data/chroma
AUDIO_TEMP_DIR=./data/audio_temp
TIMEZONE=UTC
DAILY_REFLECTION_HOUR=23
DAILY_REFLECTION_MINUTE=59
WEEKLY_SUMMARY_DAY=6
WEEKLY_SUMMARY_HOUR=20
WEEKLY_SUMMARY_MINUTE=0
MORNING_NUDGE_HOUR=9
MORNING_NUDGE_MINUTE=0
NUDGE_THRESHOLD_HOURS=24
LOG_LEVEL=INFO
LOG_FILE=./data/logs/agent.log
JSON_LOGS=false
DEBUG=false
DISABLE_SSL_VERIFY=false
