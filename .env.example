# Application
APP_ENV=development
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
PUBLIC_V2_ENABLED=false

# Database
DATABASE_URL=sqlite:///./data/weekly_agent.db
TEST_DATABASE_URL=sqlite:///./data/test_weekly_agent.db

# Telegram
TELEGRAM_INTEGRATION_ENABLED=false
TELEGRAM_BOT_TOKEN=replace_with_development_bot_token
TELEGRAM_ADMIN_ID=
TELEGRAM_WEBHOOK_SECRET=replace_with_random_webhook_secret
TELEGRAM_WEBHOOK_URL=https://replace.example/webhook
TELEGRAM_MINI_APP_URL=https://replace.example
TELEGRAM_WELCOME_IMAGE_URL=https://replace.example/pr-agent-welcome.png
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
MAX_WEBHOOK_BODY_BYTES=1048576

# Sessions and browser security
SESSION_SIGNING_SECRET=replace_with_at_least_32_random_bytes
SESSION_MAX_AGE_SECONDS=900
SESSION_COOKIE_NAME=pr_agent_session
CSRF_COOKIE_NAME=pr_agent_csrf
CORS_ORIGINS=http://localhost:3000

# Encrypted personal facts vault (Mini App only; never exposed to AI/voice)
VAULT_ENABLED=false
# Generate one key with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Format supports rotation: primary:<base64-32-byte-key>,old:<base64-32-byte-key>
VAULT_ENCRYPTION_KEYS=
VAULT_RECENT_AUTH_SECONDS=300

# AI and transcription
NUTRITION_PROVIDER=reference
GROQ_API_KEY=disabled
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.3
WHISPER_MODEL=whisper-large-v3-turbo
WHISPER_LANGUAGE=auto

# Feature gates
INVITE_ONLY=true
MESSAGE_CLEANUP_ENABLED=false
MESSAGE_CLEANUP_DELAY_SECONDS=3600
INLINE_STAGING_WORKER_ENABLED=false
INLINE_STAGING_POLL_INTERVAL_SECONDS=15
ACCOUNT_DELETION_RECENT_AUTH_SECONDS=300
OPERATIONAL_METADATA_RETENTION_DAYS=30
OPERATIONAL_PRUNE_INTERVAL_SECONDS=3600
AI_AGENT_ENABLED=false
AI_PROVIDER=disabled
AI_AGENT_MIN_CONFIDENCE=0.80
AGENT_PENDING_TTL_MINUTES=30
MAX_AGENT_INPUT_LENGTH=4000
MAX_TEXT_ENTRY_LENGTH=10000
PER_USER_REQUESTS_PER_MINUTE=120
PER_USER_DAILY_TEXT_LIMIT=250
PER_USER_DAILY_AI_LIMIT=50
PER_USER_DAILY_NUTRITION_LIMIT=50
PER_USER_DAILY_SUMMARY_LIMIT=30
PER_USER_DAILY_EXPORT_LIMIT=5
PER_USER_DAILY_VOICE_MINUTES=30
MAX_REMINDERS_PER_USER=100
MAX_VOICE_FILE_SIZE=20971520
MAX_VOICE_DURATION_SECONDS=600
VOICE_DOWNLOAD_TIMEOUT_SECONDS=30
TRANSCRIPTION_TIMEOUT_SECONDS=90
VOICE_PROVIDER_MAX_ATTEMPTS=2
INTERNAL_MONITORING_TOKEN=
SENTRY_DSN=
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_HEARTBEAT_STALE_SECONDS=120
REMINDER_WORKER_ENABLED=false

# Worker and monitoring
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=25
WORKER_LEASE_SECONDS=120
WORKER_MAX_ATTEMPTS=5
WORKER_BASE_BACKOFF_SECONDS=30

# Legacy compatibility (removed in later public-v2 phases)
WEBHOOK_URL=http://localhost:8000
CHROMA_PERSIST_DIR=./data/chroma
AUDIO_TEMP_DIR=./data/audio_temp
TIMEZONE=UTC
DAILY_REFLECTION_HOUR=23
DAILY_REFLECTION_MINUTE=59
WEEKLY_SUMMARY_DAY=6
WEEKLY_SUMMARY_HOUR=20
WEEKLY_SUMMARY_MINUTE=0
MORNING_NUDGE_HOUR=9
MORNING_NUDGE_MINUTE=0
NUDGE_THRESHOLD_HOURS=24
LOG_LEVEL=INFO
LOG_FILE=./data/logs/agent.log
JSON_LOGS=false
DEBUG=false
DISABLE_SSL_VERIFY=false
